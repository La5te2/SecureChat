[Unit]
Description=SecureChat local backend for TLS reverse proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=securechat
Group=securechat
WorkingDirectory=/opt/SecureChat
Environment=SECURECHAT_SIGNALING_TLS=0
Environment=SECURECHAT_BIND_ADDRESS=127.0.0.1
Environment=SECURECHAT_PORT=25567
ExecStart=/opt/SecureChat/out/build/x64-linux-release/server 25567
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/SecureChat

[Install]
WantedBy=multi-user.target
