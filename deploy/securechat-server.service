[Unit]
Description=SecureChat untrusted signaling and encrypted relay server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=securechat
Group=securechat
WorkingDirectory=/opt/SecureChat
Environment=SECURECHAT_SIGNALING_TLS=1
Environment=SECURECHAT_TLS_CERT_FILE=/opt/SecureChat/certs/fullchain.pem
Environment=SECURECHAT_TLS_KEY_FILE=/opt/SecureChat/certs/privkey.pem
Environment=SECURECHAT_PORT=25566
ExecStart=/opt/SecureChat/out/build/x64-linux-release/server 25566
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/SecureChat

[Install]
WantedBy=multi-user.target